{
  "name": "vouchervisiongo-editor",
  "version": "1.0.18",
  "description": "Lightweight desktop editor for reviewing VoucherVisionGO transcription results",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Will Weaver",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "js-yaml": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.vouchervision.go-editor",
    "productName": "VoucherVisionGO Editor",
    "artifactName": "VoucherVisionGO-Editor-${version}-${arch}.${ext}",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "VoucherVisionGO-Editor-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "VoucherVisionGO-Editor-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Gene-Weaver",
      "repo": "VoucherVisionGO-Editor"
    }
  }
}
